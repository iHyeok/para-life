<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Every 30 min: pull the Museum project repo and redeploy its progress site when it changed.
     Install: cp scripts/launchd/com.para-life.project-sync.plist ~/Library/LaunchAgents/ &&
              launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.para-life.project-sync.plist
     Log: ~/.claude/channels/museum/sync.log -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.para-life.project-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/mackjh/para-life/scripts/project-sync.sh</string>
    <string>museum</string>
  </array>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>/tmp/para-life-project-sync.err</string>
</dict>
</plist>
