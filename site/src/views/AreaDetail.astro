---
import DetailLayout from "./DetailLayout.astro";
import { getItem, type View } from "../lib/data";

interface Props {
  id: string;
  view: View;
}

const { id, view } = Astro.props;
const area = getItem("areas", id);
---

<DetailLayout title={area.title} view={view} body={area.body} accent="var(--purple)">
  <div class="title-row">
    <h1>{area.title}</h1>
  </div>
  {area.description && <p class="goal">{area.description}</p>}
  {area.tags && area.tags.length > 0 && (
    <div class="tags">
      {area.tags.map((t) => <span class="tag">#{t}</span>)}
    </div>
  )}
</DetailLayout>
