---
interface Props {
  status: string;
}

const { status } = Astro.props;

const colors: Record<string, string> = {
  active: "var(--green)",
  "on-hold": "var(--yellow)",
  completed: "var(--text-muted)",
  cancelled: "var(--red)",
};
---

<span class="badge" style={`--badge-color: ${colors[status] ?? "var(--text-muted)"}`}>{status}</span>
