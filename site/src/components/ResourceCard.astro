---
import TagList from "./TagList.astro";
import { detailHref, isLocked, searchAttrs, type Resource, type View } from "../lib/data";

interface Props {
  resource: Resource;
  view: View;
}

const { resource, view } = Astro.props;
const href = detailHref("resources", resource, view);
const search = searchAttrs("resources", resource, view);
---

{isLocked(resource, view) ? (
  <a href={href} class="card locked" style="--card-accent: var(--green)" {...search}>
    <h3>{resource.title}</h3>
    <span class="lock">Limited</span>
  </a>
) : (
  <article class="card" style="--card-accent: var(--green)" {...search}>
    <h3><a href={href} class="card-link">{resource.title}</a></h3>
    <div class="meta">
      {resource.topic && <span class="topic">{resource.topic}</span>}
      {resource.source && <span>{resource.source}</span>}
    </div>
    <TagList tags={resource.tags} view={view} />
  </article>
)}

<style>
  h3 {
    margin-bottom: 0.4rem;
  }

  .locked h3 {
    margin-bottom: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .topic {
    color: var(--green);
  }
</style>
