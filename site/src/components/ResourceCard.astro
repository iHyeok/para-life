---
import { detailHref, isLocked, type Resource, type View } from "../lib/data";

interface Props {
  resource: Resource;
  view: View;
}

const { resource, view } = Astro.props;
const href = detailHref("resources", resource, view);
---

{isLocked(resource, view) ? (
  <a href={href} class="card locked" style="--card-accent: var(--green)">
    <h3>{resource.title}</h3>
    <span class="lock">Limited</span>
  </a>
) : (
  <a href={href} class="card" style="--card-accent: var(--green)">
    <h3>{resource.title}</h3>
    <div class="meta">
      {resource.topic && <span class="topic">{resource.topic}</span>}
      {resource.source && <span>{resource.source}</span>}
    </div>
    {resource.tags && resource.tags.length > 0 && (
      <div class="tags">
        {resource.tags.map((tag) => <span class="tag">#{tag}</span>)}
      </div>
    )}
  </a>
)}

<style>
  h3 {
    margin-bottom: 0.4rem;
  }

  .locked h3 {
    margin-bottom: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .topic {
    color: var(--green);
  }
</style>
