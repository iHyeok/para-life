---
import TagList from "./TagList.astro";
import { detailHref, isLocked, searchAttrs, type Area, type View } from "../lib/data";

interface Props {
  area: Area;
  view: View;
}

const { area, view } = Astro.props;
const href = detailHref("areas", area, view);
const search = searchAttrs("areas", area, view);
---

{isLocked(area, view) ? (
  <a href={href} class="card locked" style="--card-accent: var(--purple)" {...search}>
    <h3>{area.title}</h3>
    <span class="lock">Limited</span>
  </a>
) : (
  <article class="card" style="--card-accent: var(--purple)" {...search}>
    <h3><a href={href} class="card-link">{area.title}</a></h3>
    {area.description && <p class="desc">{area.description}</p>}
    <TagList tags={area.tags} view={view} />
  </article>
)}

<style>
  h3 {
    margin-bottom: 0.4rem;
  }

  .locked h3 {
    margin-bottom: 0;
  }

  .desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }
</style>
