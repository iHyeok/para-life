---
import { detailHref, isLocked, type Area, type View } from "../lib/data";

interface Props {
  area: Area;
  view: View;
}

const { area, view } = Astro.props;
const href = detailHref("areas", area, view);
---

{isLocked(area, view) ? (
  <a href={href} class="card locked" style="--card-accent: var(--purple)">
    <h3>{area.title}</h3>
    <span class="lock">Limited</span>
  </a>
) : (
  <a href={href} class="card" style="--card-accent: var(--purple)">
    <h3>{area.title}</h3>
    {area.description && <p class="desc">{area.description}</p>}
    {area.tags && area.tags.length > 0 && (
      <div class="tags">
        {area.tags.map((tag) => <span class="tag">#{tag}</span>)}
      </div>
    )}
  </a>
)}

<style>
  h3 {
    margin-bottom: 0.4rem;
  }

  .locked h3 {
    margin-bottom: 0;
  }

  .desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }
</style>
