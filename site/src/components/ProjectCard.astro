---
import StatusBadge from "./StatusBadge.astro";
import PriorityDot from "./PriorityDot.astro";
import { detailHref, isLocked, listedArea, taskProgress, type Project, type View } from "../lib/data";

interface Props {
  project: Project;
  view: View;
}

const { project, view } = Astro.props;
const locked = isLocked(project, view);
const href = detailHref("projects", project, view);
const tasks = taskProgress(project.body);
const areaTitle = listedArea(project.area, view)?.title;
---

{locked ? (
  <a href={href} class="card locked" style="--card-accent: var(--accent)">
    <div class="title-row">
      <PriorityDot priority={project.priority} />
      <h3>{project.title}</h3>
    </div>
    <span class="lock">Limited</span>
  </a>
) : (
  <a href={href} class="card" style="--card-accent: var(--accent)">
    <div class="card-header">
      <div class="title-row">
        <PriorityDot priority={project.priority} />
        <h3>{project.title}</h3>
      </div>
      <StatusBadge status={project.status} />
    </div>
    {project.goal && <p class="goal">{project.goal}</p>}
    {tasks.total > 0 && (
      <div class="progress-section">
        <div
          class="progress-bar"
          role="progressbar"
          aria-valuenow={tasks.percent}
          aria-valuemin="0"
          aria-valuemax="100"
          aria-label="태스크 진행률"
        >
          <div class="progress-fill" style={`width: ${tasks.percent}%`}></div>
        </div>
        <span class="progress-text">{tasks.done}/{tasks.total}</span>
      </div>
    )}
    <div class="meta">
      {areaTitle && <span>@ {areaTitle}</span>}
      {project.deadline && (
        <span>
          마감 <time datetime={project.deadline} data-dday>{project.deadline}</time>
        </span>
      )}
      {project.updatedAt && (
        <span class="updated">
          업데이트 <time datetime={project.updatedAt} data-ago>{project.updatedAt}</time>
        </span>
      )}
    </div>
  </a>
)}

<style>
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .goal {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .progress-section {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .progress-bar {
    flex: 1;
    height: 4px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 2px;
  }

  .progress-text {
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
