---
import { detailHref, progressLog, type Project, type View } from "../lib/data";

interface Props {
  projects: Project[];
  view: View;
  limit?: number;
}

const { projects, view, limit = 8 } = Astro.props;

// Progress Log entries across projects, newest first
const entries = projects
  .flatMap((p) => progressLog(p.body).map((e) => ({ ...e, project: p })))
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, limit);
---

{entries.length > 0 ? (
  <ul class="feed">
    {entries.map((e) => (
      <li>
        <time datetime={e.date}>{e.date}</time>
        <div class="body">
          <a href={detailHref("projects", e.project, view)}>{e.project.title}</a>
          <p>
            {e.items[0]}
            {e.items.length > 1 && <span class="more"> 외 {e.items.length - 1}건</span>}
          </p>
        </div>
      </li>
    ))}
  </ul>
) : (
  <p class="empty">아직 기록된 진행 내역이 없습니다.</p>
)}

<style>
  .feed {
    list-style: none;
  }

  .feed li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.75rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--border);
  }

  time {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    padding-top: 0.1rem;
  }

  .body a {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
  }

  .body p {
    font-size: 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .more {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .empty {
    color: var(--text-muted);
    font-style: italic;
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .feed li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
