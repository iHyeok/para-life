# Project chat session (scripts/session.sh start museum)
SESSION_NAME="Museum"
SESSION_PROJECT="socratic-museum-guide"
SESSION_PORT=3861
# Tunnel route: api.kyxi.net path ^/p/museum(/|$) -> localhost:3861 (~/.cloudflared/config.yml)
SESSION_BASE="/p/museum"
# Runs inside the project's own repo (its CLAUDE.md and docs/ are the shared memory with the
# phone chat and home Claude Code sessions); para-life is added as an extra directory.
SESSION_CWD="$HOME/projects/socratic-museum-guide"
SESSION_REPO="iHyeok/socratic-museum-guide"
# Progress site rebuilt by scripts/project-sync.sh when the repo or the PARA file changes
SESSION_SITE="museum-site"
